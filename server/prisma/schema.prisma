// Prisma view of the TeslaB database.
//
// ---------------------------------------------------------------------------
// BASELINE, NOT SOURCE OF TRUTH
// ---------------------------------------------------------------------------
// This schema describes a database built from the idempotent SQL files in
// server/db. Those files remain the source of truth for the physical schema;
// this file only describes it to Prisma.
//
// Consequently:
//   * `prisma migrate` is deliberately NOT used -- it would try to take
//     ownership of the schema and to drop the CHECK constraints below, which
//     Prisma does not model.
//   * the PostGIS columns are `Unsupported`, because Prisma has no spatial
//     types. They are read and written through raw SQL -- see
//     src/db/seeds/location.seed.js and src/services/location.service.js.
//
// Naming: models and fields use idiomatic Prisma casing and are mapped onto the
// existing snake_case tables/columns with @@map/@map. These names are a Prisma
// concern only -- the database itself is unchanged.

// The classic generator is used deliberately: this server is plain JavaScript
// (no build step), and it emits a JavaScript client into node_modules that is
// imported as `@prisma/client`. The newer `prisma-client` generator emits
// TypeScript only, which would require a compile step or --experimental-strip-types.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// PostGIS location foundation
// ---------------------------------------------------------------------------

/// A Dhaka service zone.
///
/// `code` is the stable seed key and must not change when `name` does, which is
/// why both are unique and the seed upserts on code.
///
/// `centerLocation` is `geography(Point, 4326)`, seeded as the centroid of the
/// zone's own points rather than a surveyed boundary. Prisma cannot model
/// spatial types, hence Unsupported.
model ServiceZone {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String         @unique
  name           String         @unique
  active         Boolean        @default(true)
  centerLocation Unsupported("geography") @map("center_location")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  servicePoints  ServicePoint[]

  @@index([active])
  @@map("service_zones")
}

/// A node in the stored routing graph.
///
/// Deliberately a separate model from ServicePoint: service points are the
/// passenger-facing places people get in and out of, while vertices are what a
/// future router walks between. In this seed they are one-to-one, but the
/// separation is what will later let several points share one junction.
///
/// `graphNodeId` exists because pgRouting needs integer identifiers and this
/// table is keyed on a UUID. It is written once by the seeder (ranked from
/// `code` in byte order) and an immutability trigger rejects any later change,
/// because a returned route refers to edges by these numbers.
model RoutingVertex {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String         @unique
  location      Unsupported("geometry")
  graphNodeId   BigInt         @unique(map: "routing_vertices_graph_node_id_unique") @default(autoincrement()) @map("graph_node_id")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  servicePoints ServicePoint[]
  outgoingEdges RoutingEdge[]  @relation("RoutingEdgeSource")
  incomingEdges RoutingEdge[]  @relation("RoutingEdgeTarget")

  @@index([active])
  @@map("routing_vertices")
}

/// A curated pickup/drop-off location that passengers may later choose.
///
/// Always belongs to exactly one zone and always has exactly one routing
/// vertex. `(zone_id, name)` is unique so a zone cannot list the same place
/// twice; `code` is globally unique because it is both the seed key and the
/// public identifier.
model ServicePoint {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zoneId          String        @map("zone_id") @db.Uuid
  routingVertexId String        @map("routing_vertex_id") @db.Uuid
  code            String        @unique
  name            String
  location        Unsupported("geography")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  zone            ServiceZone   @relation(fields: [zoneId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  routingVertex   RoutingVertex @relation(fields: [routingVertexId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([zoneId, name], map: "service_points_zone_name_unique")
  @@index([zoneId])
  @@index([routingVertexId])
  @@index([active])
  @@index([zoneId, active], map: "service_points_zone_active_idx")
  @@map("service_points")
}

/// A directed edge in the stored routing graph.
///
/// Travel from source to target is always permitted. `bidirectional` adds the
/// return leg, which is exactly why the reverse durations must be present when
/// it is true and absent when it is not -- enforced by a CHECK constraint.
///
/// `distanceMeters` is derived from the geometry with
/// ST_Length(geometry::geography); a CHECK constraint keeps the two in step.
/// Nothing here stores money: `fareWeight` is a relative weight, not a fare.
///
/// `graphEdgeId` is what pgRouting takes as the edge `id` and reports back as
/// `edge`, so it is how a returned path is mapped to rows of this table. Like
/// `RoutingVertex.graphNodeId` it is written once and immutable.
model RoutingEdge {
  id                             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                           String        @unique
  graphEdgeId                    BigInt        @unique(map: "routing_edges_graph_edge_id_unique") @default(autoincrement()) @map("graph_edge_id")
  sourceVertexId                 String        @map("source_vertex_id") @db.Uuid
  targetVertexId                 String        @map("target_vertex_id") @db.Uuid
  geometry                       Unsupported("geometry")
  distanceMeters                 Decimal       @map("distance_meters") @db.Decimal(12, 2)
  normalDurationSeconds          Int           @map("normal_duration_seconds")
  rushHourDurationSeconds        Int           @map("rush_hour_duration_seconds")
  fareWeight                     Decimal       @default(1) @map("fare_weight") @db.Decimal(6, 3)
  reverseNormalDurationSeconds   Int?          @map("reverse_normal_duration_seconds")
  reverseRushHourDurationSeconds Int?          @map("reverse_rush_hour_duration_seconds")
  bidirectional                  Boolean       @default(false)
  active                         Boolean       @default(true)
  metadata                       Json?
  createdAt                      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sourceVertex                   RoutingVertex @relation("RoutingEdgeSource", fields: [sourceVertexId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  targetVertex                   RoutingVertex @relation("RoutingEdgeTarget", fields: [targetVertexId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([sourceVertexId])
  @@index([targetVertexId])
  @@index([active])
  @@map("routing_edges")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String    @unique
  /// Nullable on purpose: rows that predate 04-auth.sql (for example the sample
  /// users in 02-seed.sql) have no credentials. A NULL hash never authenticates.
  passwordHash String?   @map("password_hash")
  role         Role      @default(PASSENGER)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  passengerProfile PassengerProfile?
  driverProfile    DriverProfile?

  @@index([role])
  @@map("users")
}

/// Which profile a user may have follows from their role, but that rule cannot
/// be expressed as a foreign key, so it is enforced in the application service.
/// `userId` being unique is what enforces "at most one profile per user".
model PassengerProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("passenger_profiles")
}

model DriverProfile {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @unique @map("user_id") @db.Uuid
  status    DriverStatus @default(OFFLINE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicles  Vehicle[]

  @@map("driver_profiles")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Vehicle {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driverId     String        @map("driver_id") @db.Uuid
  name         String
  seatCapacity Int           @map("seat_capacity")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  driver       DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([driverId])
  @@map("vehicles")
}

/// These map onto the `user_role` and `driver_status` PostgreSQL enum types
/// created by server/db/04-auth.sql.
enum Role {
  PASSENGER
  DRIVER
  ADMIN

  @@map("user_role")
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  ON_RIDE

  @@map("driver_status")
}
