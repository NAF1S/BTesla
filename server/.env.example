# Copy to .env and adjust as needed
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Postgres (docker compose up -d db)
# Note: the container is published on 55432 because a locally installed
# PostgreSQL owns 5432 on this machine.
#
# Shared by the API and the Prisma CLI (prisma7.config.ts reads the same value
# through src/config/env.js). If this file is missing entirely, both fall back
# to the docker-compose defaults, so the API runs with no .env at all.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/TeslaB
