# Copy to .env and adjust as needed
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Postgres (docker compose up -d db)
# Note: the container is published on 55432 because a locally installed
# PostgreSQL owns 5432 on this machine.
#
# Shared by the API and the Prisma CLI (prisma7.config.ts reads the same value
# through src/config/env.js). If this file is missing entirely, both fall back
# to the docker-compose defaults, so the API runs with no .env at all.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/TeslaB

# --- Authentication ---------------------------------------------------------
# REQUIRED in production: the server refuses to start with NODE_ENV=production
# unless this is set. In development a clearly-marked insecure default is used
# so that the API still runs with no .env file at all.
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime in seconds. Drives both the JWT `exp` and the cookie Max-Age.
AUTH_TOKEN_TTL_SECONDS=7200

# Cookie name and attributes. COOKIE_SECURE defaults to true in production.
# Only use COOKIE_SAME_SITE=none (with COOKIE_SECURE=true) if the browser really
# calls the API cross-site; the default 'lax' suits the same-origin proxy setup.
AUTH_COOKIE_NAME=teslab_auth
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true

# bcrypt work factor. 10 is bcrypt's conventional default; every +1 doubles the
# time (and cost) to hash one password.
BCRYPT_COST=10

# --- Demo seed (DEVELOPMENT ONLY) -------------------------------------------
# The password given to the demo accounts (Nusrat, Rafiq, Shirin, Jashim) by
# `npm run db:seed`. See the README: these accounts must never be seeded in
# production. The seeder refuses to run there unless ALLOW_DEMO_SEED=true, and
# then it also requires DEMO_SEED_PASSWORD to be set explicitly.
DEMO_SEED_PASSWORD=DemoPass123!
# ALLOW_DEMO_SEED=true
