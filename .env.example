# Optional overrides for docker-compose.yml (root .env).
# Copy to `.env` only if you want to change the defaults.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=TeslaB

# Host port the container is published on. 55432 by default because 5432 is
# held by a local PostgreSQL service on this machine.
POSTGRES_PORT=55432
